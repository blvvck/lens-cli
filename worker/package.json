{
  "name": "lens-feedback-worker",
  "version": "1.0.0",
  "description": "Hosted feedback ingest endpoint for lens-cli",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply feedback-db",
    "db:migrate:local": "wrangler d1 migrations apply feedback-db --local",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.70.0"
  }
}
