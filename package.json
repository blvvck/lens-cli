{
  "name": "@lens-cli/lens",
  "version": "1.0.1",
  "description": "CLI for AI agents to control Chrome. Zero config, agent-agnostic, battle-tested.",
  "keywords": [
    "chrome",
    "browser",
    "automation",
    "ai",
    "agent",
    "cli",
    "cdp",
    "devtools"
  ],
  "author": "Isaac Ejeh",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lens": "native/cli/index.cjs"
  },
  "exports": {
    ".": "./native/client.cjs",
    "./client": "./native/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "native/",
    "scripts/",
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:test": "biome check test/",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "install:native": "node scripts/install-host.cjs",
    "uninstall:native": "node scripts/uninstall-host.cjs"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "stream-browserify": "^3.0.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/chrome": "^0.0.287",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
